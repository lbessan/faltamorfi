# Supabase — sacalas desde el dashboard de tu proyecto:
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — la usa el cron de Vercel para consultar todos los usuarios
# (bypass de RLS). NUNCA se sirve al cliente. Settings → API → "service_role".
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — necesaria a partir de la Fase 3b (IA freezer).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Web Push (Fase 3c — notificaciones push de la PWA)
# Generadas con: npx web-push generate-vapid-keys
# La pública se sirve al cliente, la privada NUNCA debe filtrarse.
# VAPID_SUBJECT es un mailto: tuyo (Firefox lo requiere para identificar al sender).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vos@ejemplo.com

# Secret del cron job de Vercel (Fase 3c).
# Vercel manda este header en sus crons; verificamos que coincida.
# Generá uno con: openssl rand -hex 32  (o cualquier string aleatorio largo).
CRON_SECRET=
